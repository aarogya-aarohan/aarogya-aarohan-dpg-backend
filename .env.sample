PORT=3000

FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_TOKEN_URL=http://localhost:8080/auth/realms/arogyam/protocol/openid-connect/token
FHIR_CLIENT_ID=client
FHIR_CLIENT_SECRET=secret

DIAGNOSIS_ENABLED=false
DIAGNOSIS_QUESTIONNAIRE_REFERENCE=Questionnaire/OralCancerScreenPatient
DIAGNOSIS_TASK_INSTANTIATE_CANONICAL=https://midas.iisc.ac.in/fhir/ActivityDefinition/oral-cancer-screen-patient
DIAGNOSIS_TASK_FOLLOW_UP_URI=https://midas.iisc.ac.in/fhir/Task/oral-cancer-screening-follow-up
DIAGNOSIS_PER_CRON_ENCOUNTER=100
DIAGNOSIS_CRON_LOCK_MINUTES=30

EXPORT_ENABLED=false
EXPORT_SITE_ID=site-2
EXPORT_FHIR_URL=http://localhost:8080/fhir
EXPORT_TOKEN_URL=http://localhost:8080/auth/realms/arogyam/protocol/openid-connect/token
EXPORT_CLIENT_ID=import-client
EXPORT_CLIENT_SECRET=sample-secret
EXPORT_PER_CRON_ENCOUNTER=1
EXPORT_CRON_LOCK_MINUTES=5

READER_ENABLED=true
READER_PER_CRON_MEDIA=1
READER_CRON_LOCK_MINUTES=1
READER_TASK_INTERVAL_DAYS=30

UPLOAD_STATUS_ENABLED=true
UPLOAD_STATUS_CRON_LOCK_MINUTES=2880
UPLOAD_STATUS_APPLY=true

DIAGNOSIS_NON_SUSP_PERCENT=5
DIAGNOSIS_NON_SUSPICIOUS_CRON_LOCK_MINUTES=480
DIAGNOSIS_NON_SUSPICIOUS_MIN_ENCOUNTER_AGE_HOURS=24
DIAGNOSIS_NON_SUSPICIOUS_DAILY_CRON_EXPRESSION=EVERY_DAY_AT_6PM

DIAGNOSIS_SPECIALIST_DAILY_CRON_EXPRESSION=EVERY_DAY_AT_6PM
DIAGNOSIS_SPECIALIST_CRON_LOCK_MINUTES=480
DIAGNOSIS_SPECIALIST_TASK_LIMIT=25
DIAGNOSIS_SPECIALIST_SOURCE_TASK_ID_EXTENSION_URL=http://midas.iisc.ac.in/diagnosis-specialist-source-task-id
DIAGNOSIS_SPECIALIST_REVIEW_QUESTIONNAIRE_REFERENCE=Questionnaire/OralCancerReviewPatient
DIAGNOSIS_SPECIALIST_REVIEW_TASK_INSTANTIATE_CANONICAL=https://midas.iisc.ac.in/fhir/ActivityDefinition/oral-cancer-review-patient

# Optional startup cron overrides. Blank/unset retains the existing frequency.
# Use cron expressions (5 fields, or 6 with seconds), not EVERY_* aliases.
# Restart the application after changing a schedule. Lock minutes are separate.
DIAGNOSIS_PHASE1_CRON_EXPRESSION="0 */5 * * * *"
DIAGNOSIS_SUSPICIOUS_CRON_EXPRESSION="0 */5 * * * *"
READER_CRON_EXPRESSION="0 * * * * *"
UPLOAD_STATUS_CRON_EXPRESSION="0 * * * * *"
EXPORT_CRON_EXPRESSION="0 * * * * *"
